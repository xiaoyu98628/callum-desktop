{
  "name": "callum-desktop",
  "version": "0.1.0",
  "description": "Callum 桌面客户端",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json && vue-tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run format:check"
  },
  "dependencies": {
    "@lucide/vue": "1.67.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "reka-ui": "2.11.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.2.2",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  }
}
